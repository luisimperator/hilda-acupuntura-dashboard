# Credenciais do Google Ads — veja o README.md para como obter cada uma.
# NUNCA comite o .env de verdade (o .gitignore já ignora).

# Do projeto no Google Cloud (tela de credenciais OAuth):
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Do Google Ads API Center (na conta administradora/MCC):
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxxxxxxxxxx

# Gerado pelo fluxo OAuth (OAuth Playground ou o script do README):
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxx

# A conta de anúncios (10 dígitos, SEM traços). Ex.: 1234567890
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Só se você acessa via conta administradora (MCC): o ID dela, sem traços.
# Se a conta acima é direta, deixe em branco / remova esta linha.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Moeda da conta, só para formatar os relatórios (padrão BRL).
GOOGLE_ADS_MOEDA=BRL
